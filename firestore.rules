rules_version = '2';

// Reglas de coLab tour (IT-3, ajustadas en IT-4, IT-5 e IT-6). Sin Cloud Functions, algunas escrituras sobre datos ajenos
// se permiten de forma acotada: sumar puntos al autor, mover contadores y crear notificaciones.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isModerator() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MODERATOR';
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function placeAuthor(placeId) {
      return get(/databases/$(database)/documents/places/$(placeId)).data.authorId;
    }

    // Carga inicial de datos de prueba (FirestoreSeeder): solo mientras no exista meta/seed.
    // Para volver a cargarlos se borra meta/seed desde la consola.
    function seeding() {
      return !exists(/databases/$(database)/documents/meta/seed);
    }

    match /{document=**} {
      allow read, write: if seeding();
    }

    match /meta/{docId} {
      allow read: if true;
    }

    match /users/{uid} {
      allow read: if signedIn();
      // Al registrarse: siempre como USER y sin puntos (los moderadores se precargan).
      allow create: if isOwner(uid)
        && request.resource.data.role == 'USER'
        && request.resource.data.points == 0;
      // El dueño edita su perfil, su contador de comentarios y sus insignias, pero no su rol, sus puntos
      // ni su nivel. Cualquiera puede sumarle puntos (lo que da una acción: entre 1 y 50) y el nivel
      // que resulta, en la misma escritura (IT-6).
      allow update: if (isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'points', 'level']))
        || (signedIn()
          && onlyChanges(['points', 'level'])
          && request.resource.data.points > resource.data.get('points', 0)
          && request.resource.data.points - resource.data.get('points', 0) <= 50
          && request.resource.data.level in ['TURISTA', 'EXPLORADOR', 'AVENTURERO', 'EMBAJADOR_LOCAL']);
      allow delete: if isOwner(uid);

      match /visits/{placeId} {
        allow read, write: if isOwner(uid);
      }

      // Espejo de los votos: lo escribe el dueño; el autor de la publicación lo borra al eliminarla.
      match /votedPlaces/{placeId} {
        allow read, create: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(placeAuthor(placeId));
      }
    }

    // IT-8: toda publicación nueva o editada por su autor lleva de 1 a 6 fotos en la nube (https).
    function validImages() {
      return request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() >= 1
        && request.resource.data.imageUrls.size() <= 6;
    }

    match /places/{placeId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validImages()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.votesCount == 0
        && request.resource.data.get('visitsCount', 0) == 0;
      // Autor (IT-5): edita su publicación sin tocar contadores, autor ni datos de moderación.
      //   - Editar la devuelve a PENDIENTE y borra el motivo de rechazo (no puede editar
      //     algo verificado y dejarlo verificado: cualquier cambio vuelve a revisión).
      //   - Solo puede marcarla RESUELTA si ya estaba VERIFICADA (si no, saltaría la moderación).
      //   - Nunca puede ponerla VERIFICADA ni RECHAZADA ni escribir moderatorId / reviewedAt.
      // Moderador: verifica, rechaza o resuelve (resolver, igual que el autor, solo desde VERIFICADA). Cualquiera: solo el contador de votos o el de visitas (T-05).
      allow update: if (isOwner(resource.data.authorId)
          && (validImages() || request.resource.data.status == 'RESUELTA')
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.votesCount == resource.data.votesCount
          && request.resource.data.get('visitsCount', 0) == resource.data.get('visitsCount', 0)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['moderatorId', 'reviewedAt'])
          && (request.resource.data.get('rejectionReason', null) == null
              || request.resource.data.get('rejectionReason', null) == resource.data.get('rejectionReason', null))
          && (request.resource.data.status == 'PENDIENTE'
              || (request.resource.data.status == 'RESUELTA' && resource.data.status == 'VERIFICADA')))
        || (isModerator()
          && (request.resource.data.status != 'RESUELTA'
              || resource.data.status == 'RESUELTA'
              || resource.data.status == 'VERIFICADA'))
        || (signedIn() && onlyChanges(['votesCount']))
        || (signedIn() && onlyChanges(['visitsCount']));
      allow delete: if isOwner(resource.data.authorId) || isModerator();

      match /votes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(placeAuthor(placeId)) || isModerator();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if isOwner(resource.data.authorId) || isOwner(placeAuthor(placeId)) || isModerator();
      }
    }

    // Historial permanente de moderación (M-06): lo crea el moderador por sus propias acciones,
    // solo él lo lee y nadie lo modifica ni lo borra.
    match /moderationLog/{logId} {
      allow read: if isOwner(resource.data.moderatorId);
      allow create: if isModerator()
        && request.resource.data.moderatorId == request.auth.uid
        && request.resource.data.action in ['VERIFIED', 'REJECTED', 'RESOLVED']
        && request.resource.data.xpAwarded is int
        && request.resource.data.xpAwarded <= 65;
    }

    // Contadores, XP y trofeos del moderador (M-06). Solo él los lee, y solo cambian si en el mismo
    // lote se crea una entrada nueva de su historial (lastLogId): así no se puede sumar XP sin revisar.
    function previous(field) {
      return resource == null ? 0 : resource.data.get(field, 0);
    }

    function validModerationWrite(uid) {
      let logPath = /databases/$(database)/documents/moderationLog/$(request.resource.data.lastLogId);
      return isModerator() && isOwner(uid)
        && !exists(logPath)
        && existsAfter(logPath)
        && getAfter(logPath).data.moderatorId == uid
        && request.resource.data.reviewedCount == previous('reviewedCount') + 1
        && request.resource.data.xp - previous('xp') == getAfter(logPath).data.xpAwarded;
    }

    match /moderatorStats/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if validModerationWrite(uid);
    }

    // Cada usuario lee y marca como leídas solo sus notificaciones; cualquiera puede enviarle una.
    match /notifications/{notificationId} {
      allow read, delete: if isOwner(resource.data.userId);
      allow create: if signedIn();
      allow update: if isOwner(resource.data.userId) && onlyChanges(['isRead']);
    }
  }
}
